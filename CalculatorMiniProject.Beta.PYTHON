a = float(input("Enter the frist number: "))
b = float(input("Enter the second number: "))
operator = (input("Enter an operator(+, -, *, /, %, **): "))

if operator == '+':
    print(a + b)
elif operator == '-':
    print(a - b)
elif operator == '*':
    print(a * b)
elif operator == '/':
    print(a / b)
elif operator == '%':
    print(a % b)
elif operator == '**':
    print(a ** b)
else:
    print ("INVALID OPERATION")
